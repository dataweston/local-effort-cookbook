  "identifier": "angular2cookbook0000fris",
  "title": "Angular 2 cookbook : discover over 70 recipes that provide the solutions you need to know to face every challenge in Angular 2 head on",
  "creator": "Frisbie, Matt, author",
  "year": 2017,
